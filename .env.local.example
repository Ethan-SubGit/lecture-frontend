# ─────────────────────────────────────────────────────────────────────────────
# 백엔드 API Base URL
#
# 주의 1: Swagger UI 주소(http://58.239.220.254:3330/api)가 아니다.
#         실제 엔드포인트에는 /api 접두어가 없다.
# 주의 2: 2026-07-30 점검 기준 백엔드에 CORS 가 설정되어 있지 않다.
#         (응답에 Access-Control-Allow-Origin 없음 / OPTIONS 프리플라이트 404)
#         브라우저 직접 호출이 차단되므로 기본값을 same-origin 프록시 경로로 둔다.
#         프록시는 next.config.mjs 의 rewrites 가 백엔드로 전달한다.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_BASE_URL=/backend-proxy

# 백엔드에 CORS 가 설정되면 위 줄을 지우고 아래 줄을 사용한다(브라우저 직접 호출).
# NEXT_PUBLIC_API_BASE_URL=http://58.239.220.254:3330

# 프록시가 바라볼 실제 백엔드 오리진(서버 전용 변수). 생략 시 위 주소가 기본이다.
# BACKEND_ORIGIN=http://58.239.220.254:3330
