"}}}},"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GradeScale"}}}},"400":{"description":"최소 점수가 최대 점수보다 큰 경우"},"404":{"description":"학점환산 기준을 찾을 수 없음"},"409":{"description":"이미 등록된 등급"}},"security":[{"access-token":[]}],"summary":"학점환산 기준 수정","tags":["grade-scales"]},"delete":{"operationId":"GradeScalesController_remove","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"204":{"description":"삭제 성공 (응답 본문 없음)"},"404":{"description":"학점환산 기준을 찾을 수 없음"}},"security":[{"access-token":[]}],"summary":"학점환산 기준 삭제 (소프트 삭제)","tags":["grade-scales"]}},"/student-scores/upload":{"post":{"description":"엑셀 컬럼 순서: 학번/이름/학과/중간고사점수/중간과제점수/기말고사점수/기말과제점수. 합계점수와 등급은 서버에서 계산한다. 강의가 없거나 이미 등록된 성적이 있으면 500 에러로 실패한다.","operationId":"StudentScoresController_uploadExcel","parameters":[],"requestBody":{"required":true,"content":{"multipart/form-data":{"schema":{"type":"object","required":["file","lectureName"],"properties":{"file":{"type":"string","format":"binary","description":"성적 엑셀 파일"},"lectureName":{"type":"string","example":"자료구조","description":"성적을 등록할 강의명"},"term":{"type":"string","example":"2610","description":"개설학기 코드 (미입력 시 기본값 2610)"}}}}}},"responses":{"201":{"description":"업로드 성공 (형식 오류 행은 failedRows에 담겨 반환된다)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/UploadExcelResponseDto"}}}},"400":{"description":"엑셀 파일 미첨부 또는 강의명/학기 형식 오류"},"500":{"description":"존재하지 않는 강의이거나(사전 등록 필수), 해당 강의에 이미 등록된 성적이 있거나, 엑셀 파일 내에 학번이 중복된 경우. 이 경우 아무것도 저장되지 않는다."}},"security":[{"access-token":[]}],"summary":"성적 엑셀 파일 업로드 (강의 1개 단위 일괄 등록)","tags":["student-scores"]}},"/student-scores":{"get":{"operationId":"StudentScoresController_findAll","parameters":[{"name":"page","required":false,"in":"query","description":"조회할 페이지 번호 (1부터 시작, 기본값 1)","schema":{"minimum":1,"example":1,"type":"number"}},{"name":"pageSize","required":false,"in":"query","description":"페이지당 조회 개수 (기본값 20). 전체 다운로드 등을 위해 상한선은 두지 않는다","schema":{"minimum":1,"example":20,"type":"number"}},{"name":"lectureName","required":false,"in":"query","description":"강의명 부분 검색","schema":{"example":"자료구조","type":"string"}},{"name":"studentName","required":false,"in":"query","description":"학생 이름 부분 검색","schema":{"example":"홍길동","type":"string"}},{"name":"studentNumber","required":false,"in":"query","description":"학번 정확히 일치 검색","schema":{"example":"20231234","type":"string"}},{"name":"departmentName","required":false,"in":"query","description":"학과명 부분 검색","schema":{"example":"컴퓨터공학과","type":"string"}},{"name":"sortBy","required":false,"in":"query","description":"정렬 기준 필드 (studentNumber | studentName | departmentName | totalScore | grade)","schema":{"example":"totalScore","type":"string","enum":["studentNumber","studentName","departmentName","totalScore","grade"]}},{"name":"order","required":false,"in":"query","description":"정렬 방향 (기본값 ASC)","schema":{"example":"ASC","type":"string","enum":["ASC","DESC"]}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/FindStudentScoresResponseDto"}}}}},"security":[{"access-token":[]}],"summary":"강의별 수강생 성적 목록 조회 (페이지네이션/검색/정렬)","tags":["student-scores"]}},"/student-scores/{id}":{"get":{"operationId":"StudentScoresController_findOne","parameters":[{"name":"id","required":true,"in":"path","schema":{"type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudentScore"}}}},"404":{"description":"성적 정보를 찾을 수 없음"}},"security":[{"access-token":[]}],"summary":"성적 단건 조회","tags":["student-scores"]}},"/dashboard/summary":{"get":{"description":"전체 학과/강의/성적 건수, 평균 합계점수와 평균 평점(GPA), 등급별 분포, 학과별/강의별/학기별 통계를 한 번에 반환한다.","operationId":"DashboardController_getSummary","parameters":[],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DashboardSummaryDto"}}}}},"security":[{"access-token":[]}],"summary":"대시보드 요약 통계 조회","tags":["dashboard"]}},"/dashboard/department-achievement":{"get":{"description":"학과별 평균/중앙값/표본표준편차/최소·최대 점수, 평균 평점, A·F등급 비율과 학과 × 등급 교차표를 반환한다. 교차표의 등급 축은 학점환산표의 평점 내림차순이며, 해당 등급을 받은 학생이 없어도 0으로 채워진다. 성적이 한 건도 없는 학과는 포함되지 않으므로 전체 학과 목록이 필요하면 GET /departments 결과와 병합한다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getDepartmentAchievement","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DepartmentAchievementResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"학과별 학업성취도 조회","tags":["dashboard"]}},"/dashboard/lecture-difficulty":{"get":{"description":"강의별 평균/표본표준편차/평균 평점/A·F등급 비율과, 필터 집합 전체 가중평균 대비 편차를 반환한다. A등급 비율 50% 이상이면 gradeInflation=true, 전체 평균과 10%p 이상 차이나면 difficultyOutlier가 EASY/HARD로 표시된다. minStudentCount(기본 1)로 수강생이 적은 강의를 제외할 수 있다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getLectureDifficulty","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}},{"name":"minStudentCount","required":false,"in":"query","description":"이 인원수 이상인 강의만 포함한다 (기본값 1). 수강생이 적은 강의의 통계 왜곡을 걸러낼 때 사용","schema":{"minimum":1,"example":1,"type":"number"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/LectureDifficultyResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"강의별 난이도·성적편차 조회","tags":["dashboard"]}},"/dashboard/component-analysis":{"get":{"description":"중간고사/중간과제/기말고사/기말과제 항목별 평균과, 시험 대비 과제 격차, 학기 전반부 대비 후반부 향상도를 전체(overall)와 강의별(byLecture)로 반환한다. 항목별 만점 정보가 없으므로 개별 항목에는 백분율을 제공하지 않는다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getComponentAnalysis","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ComponentAnalysisResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"평가항목별 분석 조회","tags":["dashboard"]}},"/dashboard/score-histogram":{"get":{"description":"합계점수를 bucketSize(기본 10) 단위 구간으로 나눠 인원수와 비율을 반환한다. 데이터가 없는 구간도 count 0으로 포함되며, 만점을 받은 학생은 최상단 구간에 포함된다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getScoreHistogram","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}},{"name":"bucketSize","required":false,"in":"query","description":"점수 구간의 폭 (기본값 10). 만점을 이 값으로 나눠 구간을 만든다","schema":{"minimum":1,"maximum":100,"example":10,"type":"number"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ScoreHistogramResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"점수 구간 히스토그램 조회","tags":["dashboard"]}},"/dashboard/term-trend":{"get":{"description":"학기별 성적 건수, 평균 합계점수, 평균 평점을 시계열로 반환한다. breakdown=department를 주면 학과별 시리즈(departmentSeries)가 추가된다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getTermTrend","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}},{"name":"breakdown","required":false,"in":"query","description":"학과별 시리즈 포함 여부 (기본값 none). 'department'를 주면 학과별 라인 데이터가 추가된다","schema":{"example":"none","type":"string","enum":["none","department"]}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TermTrendResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"학기별 추이 조회","tags":["dashboard"]}},"/dashboard/department-lecture-matrix":{"get":{"description":"강의를 행, 학과를 열로 하는 교차표를 반환한다. 각 셀은 해당 강의 전체 평균 대비 편차를 함께 제공하므로 강의 난이도의 영향을 제외한 학과별 상대 성취를 비교할 수 있다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getDepartmentLectureMatrix","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DepartmentLectureMatrixResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"학과 × 강의 교차 통계 조회","tags":["dashboard"]}},"/dashboard/student-ranking":{"get":{"description":"학번 단위로 종합 평균 평점(GPA)을 계산해 상위 limit명(기본 10, 최대 100)을 반환한다. 순위는 SQL RANK()로 매겨 동점자에게 같은 순위를 부여한다. minLectureCount(기본 1)로 소수 과목만 수강한 학생을 제외할 수 있다. 학생 마스터 테이블이 없어 집계 단위는 학번이며, 이름/학과는 성적 레코드의 최빈값이다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getStudentRanking","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","required":false,"in":"query","description":"강의 ID로 필터링","schema":{"format":"uuid","example":"8c7b6a5d-4e3f-2a1b-0c9d-8e7f6a5b4c3d","type":"string"}},{"name":"limit","required":false,"in":"query","description":"조회할 상위 인원수 (기본값 10, 최대 100)","schema":{"minimum":1,"maximum":100,"example":10,"type":"number"}},{"name":"minLectureCount","required":false,"in":"query","description":"이 강의 수 이상을 수강한 학생만 포함한다 (기본값 1). 1과목만 듣고 1위가 되는 왜곡을 막을 때 사용","schema":{"minimum":1,"example":1,"type":"number"}}],"responses":{"200":{"description":"","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StudentRankingResponseDto"}}}},"400":{"description":"쿼리 파라미터 형식이 올바르지 않음"}},"security":[{"access-token":[]}],"summary":"학생 종합 성적 랭킹 조회","tags":["dashboard"]}},"/dashboard/at-risk-students":{"get":{"description":"F학점 개수가 failCountAtLeast(기본 1) 이상이거나, 평균 성취도가 averageBelow(기본 60)% 미만인 학생을 위험한 순으로 반환한다. 두 조건은 OR로 결합되며 riskReasons에 걸린 사유가 담긴다. limit 기본 50, 최대 200. 학생 마스터 테이블이 없어 집계 단위는 학번이며, 이름/학과는 성적 레코드의 최빈값이다. 공통 필터: term(학기), departmentId(학과), lectureId(강의). 모두 선택이며 AND로 결합된다. 존재하지 않는 id를 주면 404가 아니라 빈 결과가 반환된다. 소프트 삭제된 학과/강의에 속한 성적은 집계에서 제외된다.","operationId":"DashboardController_getAtRiskStudents","parameters":[{"name":"term","required":false,"in":"query","description":"개설학기 코드 (YY10=1학기, YY11=계절학기, YY20=2학기, YY21=계절학기)","schema":{"example":"2610","type":"string"}},{"name":"departmentId","required":false,"in":"query","description":"학과 ID로 필터링","schema":{"format":"uuid","example":"3f1a2b4c-5d6e-7f80-9a1b-2c3d4e5f6a7b","type":"string"}},{"name":"lectureId","